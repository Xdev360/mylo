# Mylo website: every environment variable it reads.
# Copy to .env.local for local work; set the same names in Vercel for production.

# Optional. The waitlist joins through join_waitlist_v2() on the Mylo
# Supabase project with its publishable key, the same pair js/config.js ships
# to every browser, and both are the defaults in app/api/waitlist/route.ts.
# Set these only to point the site at a different project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email. A Resend API key turns on the waitlist confirmation and the signup
# alert, once staymylo.com is verified in Resend. Without one, signups still save.
RESEND_API_KEY=
# Fallback sender: staymylo.com is already authenticated with Brevo.
BREVO_API_KEY=
# The sender. Default hello@staymylo.com.
MAIL_FROM_EMAIL=

# Where the alert for each new signup goes, once email is set up.
# Default hello@staymylo.com.
WAITLIST_NOTIFY_EMAIL=

# Optional. The From line on that email. The domain must be verified in Resend.
WAITLIST_FROM_EMAIL="Mylo <hello@staymylo.com>"

# Launch day switch. false until 3 December. true swaps in the launch-day
# hero and closing CTA, turns the buttons into "Open Mylo" (app.staymylo.com),
# removes the email field and the "Already in the waitlist" block.
# Read at build time: change it, then redeploy.
LAUNCHED=false

# Only for scripts/pull-figma-assets.mjs (re-exporting art from Figma). The site never reads it.
FIGMA_TOKEN=
